{
  "name": "cubeforge-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}' 'integrations/*/src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx}' 'integrations/*/src/**/*.{ts,tsx}'",
    "prepare": "git config core.hooksPath .githooks",
    "pack:smoke": "pnpm build && node scripts/publish-packages.mjs smoke",
    "size": "node scripts/bundle-size.mjs && node scripts/bundle-size.mjs --entry cubeforge/render",
    "size:check": "node scripts/bundle-size.mjs --entry cubeforge/render --check 28500 --forbid _pkg/physics/,_pkg/audio/,_pkg/net/,_pkg/editor/,_pkg/devtools/,_pkg/gameplay/ && node scripts/bundle-size.mjs --check 56500 --forbid _pkg/net/,_pkg/editor/,_pkg/gameplay/"
  },
  "devDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.21.0",
    "happy-dom": "^14.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
