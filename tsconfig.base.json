{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@xip/audio": ["packages/audio/src/index.ts"],
      "@xip/context": ["integrations/context/src/index.ts"],
      "@xip/core": ["packages/core/src/index.ts"],
      "@xip/devtools": ["integrations/devtools/src/index.ts"],
      "@xip/editor": ["integrations/editor/src/index.ts"],
      "@xip/gameplay": ["integrations/gameplay/src/index.ts"],
      "@xip/input": ["packages/input/src/index.ts"],
      "@xip/net": ["packages/net/src/index.ts"],
      "@xip/physics": ["packages/physics/src/index.ts"],
      "@xip/renderer/canvas2d": ["packages/renderer/src/canvas2dRenderSystem.ts"],
      "@xip/renderer": ["packages/renderer/src/index.ts"],
      "xipjs": ["integrations/xip/src/index.ts"],
      "xipjs/advanced": ["integrations/xip/src/advanced.ts"],
      "xipjs/render": ["integrations/xip/src/render.ts"],
      "xipjs/test": ["integrations/xip/src/test.ts"]
    }
  }
}
